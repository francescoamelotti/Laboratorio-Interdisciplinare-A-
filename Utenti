package cinemax;

import java.util.ArrayList;
import java.util.List;
import java.io.BufferedReader;
import java.io.FileReader;
import java.io.IOException;

public class Utente {
    private String nome;
    private String cognome;
    private String username;
    private String password;
    private String dataNascita;
    private String domicilio;
    private String ruolo;

    public Utente(String nome, String cognome, String username, String password, String dataNascita, String domicilio, String ruolo) {
        this.nome = nome;
        this.cognome = cognome;
        this.username = username;
        this.password = password;
        this.dataNascita = dataNascita;
        this.domicilio = domicilio;
        this.ruolo = ruolo;
    }

    public String getNome() {
        return nome;
    }

    public void setNome(String nome) {
        this.nome = nome;
    }

    public String getCognome() {
        return cognome;
    }

    public void setCognome(String cognome) {
        this.cognome = cognome;
    }

    public String getUsername() {
        return username;
    }

    public void setUsername(String username) {
        this.username = username;
    }

    public String getPassword() {
        return password;
    }

    public void setPassword(String password) {
        this.password = password;
    }

    public String getDataNascita() {
        return dataNascita;
    }

    public void setDataNascita(String dataNascita) {
        this.dataNascita = dataNascita;
    }

    public String getDomicilio() {
        return domicilio;  

    }

    public void setDomicilio(String domicilio) {
        this.domicilio = domicilio;
    }

    public String getRuolo() {
        return ruolo;
    }
    
    public void setRuolo(String ruolo) {
        this.ruolo = ruolo;
    }


public class GestoreDiUtenti {

    public static List<Utente> caricaUtentiDaCSV(String filePercorso) {
        List<Utente> utenti = new ArrayList<>();
        String riga;
        boolean primaRiga = true;

        try (BufferedReader br = new BufferedReader(new FileReader(filePercorso))) {

            while ((riga = br.readLine()) != null) {
                
                if (primaRiga) {
                    primaRiga = false;
                    continue;
                }

                if (riga.trim().isEmpty()) {
                    continue;
                }

                String[] dati = riga.split(",(?=(?:[^\"]*\"[^\"]*\")*[^\"]*$)", -1); // Split CSV, considerando le virgolette e mantenendo i campi vuoti

                if (dati.length == 7) {
                    try {
                        String nome = pulisciStringa(dati[0]);
                        String cognome = pulisciStringa(dati[1]);
                        String username = pulisciStringa(dati[2]);
                        String password = pulisciStringa(dati[3]);
                        String dataStringa = pulisciStringa(dati[4]);
                        String dataNascita = null;
                        if (!dataStringa.isEmpty()) {
                            dataNascita = dataStringa; 
                        }
                        String domicilio = pulisciStringa(dati[5]);
                        String ruolo = pulisciStringa(dati[6]);

                        utenti.add(new Utente(nome, cognome, username, password, dataNascita, domicilio, ruolo));

                    } catch (Exception e) {
                        System.err.println("Riga utente malformata saltata: " + riga);
                    }
                } else {
                    System.err.println("Numero di campi errato nella riga: " + riga);
                }
            }

        } catch (IOException e) {
            System.err.println("Errore critico di lettura file utenti: " + e.getMessage());
        }

        return utenti;
    }

    
    public static void salvaNuovoUtenteSuCSV(String filePercorso, Utente nuovoUtente) {
        try (BufferedWriter bw = new BufferedWriter(new FileWriter(filePercorso, true))) {
            String dataStr = (nuovoUtente.getDataNascita() != null) ? nuovoUtente.getDataNascita() : "";

            String rigaCsv = nuovoUtente.getNome() + "," +
                             nuovoUtente.getCognome() + "," +
                             nuovoUtente.getUsername() + "," +
                             nuovoUtente.getPassword() + "," +
                             dataStr + "," +
                             nuovoUtente.getDomicilio() + "," +
                             nuovoUtente.getRuolo();
                bw.write(rigaCsv);
            bw.newLine();
        } catch (IOException e) {
            System.err.println("Errore critico di scrittura file utenti: " + e.getMessage());
        }
    }

    private static String pulisciStringa(String input) { // Rimuove eventuali spazi bianchi e virgolette
        if (input == null) return "";
        return input.trim().replace("\"", "");
    }
}
